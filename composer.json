{
    "name": "firewalker/fio-client-php-7.4",
    "description": "PHP client for the Fio Bank API with DTO support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Josef Rezek",
            "email": "josef.rezek@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.0",
        "nyholm/psr7": "^1.8",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
    }
}
